    "babel-preset-expo": "^57.0.13",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "expo-constants": "$expo-constants"
  },
  "scripts": {
    "start": "APP_VARIANT=development expo run:ios",
    "android": "APP_VARIANT=development expo run:android --port 8087",
    "prebuild:dev": "APP_VARIANT=development expo prebuild -p ios",
    "prebuild:dev:android": "APP_VARIANT=development expo prebuild -p android",
    "lint": "expo lint",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "typecheck:android": "tsc --noEmit -p tsconfig.android.json",
    "db:generate": "drizzle-kit generate",
    "e2e": "maestro test .maestro/",
    "e2e:onboarding": "maestro test --include-tags onboarding .maestro/",
    "e2e:session": "maestro test --include-tags session .maestro/",
    "e2e:build": "eas build --local -p ios -e e2e-simulator --output build/e2e-simulator.tar.gz && ./scripts/record-e2e-fingerprint.sh"
  },
  "private": true,
  "trustedDependencies": [
    "@shopify/react-native-skia"
  ]
