# dependencies
node_modules/

# Expo
.expo/
dist/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# local build artifacts: `bun run e2e:build` writes build/e2e-simulator.tar.gz; the
# build-*.tar.gz / *.app patterns catch a bare `eas build --local`, which drops its
# timestamped artifact in the cwd instead.
/build/
build-*.tar.gz
*.app

# Claude Code session worktrees
.claude/worktrees/

# Field-test exports: they contain the runner's home coordinates (start and finish of every run)
/field-data/
