{
  // Kinds stay qualified: unqualified `source.fixAll` / `source.organizeImports`
  // prefix-match every provider, so ESLint+Prettier and TypeScript's import
  // rewriter both rewrote the buffer in one save pass and TS's stale offsets ate code.
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  // No biome.json or @biomejs/biome here (ADR 0014: Prettier via ESLint).
  "biome.enabled": false,

  // tsserver otherwise falls back to VS Code's bundled TypeScript, older than the
  // pinned ~6.0.3. Loading it needs a one-time prompt (enablePromptUseWorkspaceTsdk).
  "typescript.tsdk": "node_modules/typescript/lib",

  // Uniwind (ADR 0002) routes styling through per-prop classNames rather than one
  // `class` attribute, and IntelliSense only completes inside attributes listed here.
  // List per https://docs.uniwind.dev/quickstart.
  "tailwindCSS.classAttributes": [
    "class",
    "className",
    "headerClassName",
    "contentContainerClassName",
    "columnWrapperClassName",
    "endFillColorClassName",
    "imageClassName",
    "tintColorClassName",
    "ios_backgroundColorClassName",
    "thumbColorClassName",
    "trackColorOnClassName",
    "trackColorOffClassName",
    "selectionColorClassName",
    "cursorColorClassName",
    "underlineColorAndroidClassName",
    "placeholderTextColorClassName",
    "selectionHandleColorClassName",
    "colorsClassName",
    "progressBackgroundColorClassName",
    "titleColorClassName",
    "underlayColorClassName",
    "colorClassName",
    "drawerBackgroundColorClassName",
    "statusBarBackgroundColorClassName",
    "backdropColorClassName",
    "backgroundColorClassName",
    "ListFooterComponentClassName",
    "ListHeaderComponentClassName"
  ],
  // Mirrors `tailwindFunctions` in .prettierrc so completion and class sorting
  // agree on the same call sites.
  "tailwindCSS.classFunctions": ["cva", "cn", "useResolveClassNames"],

  // files.associations outranks an extension's own filenamePatterns, so a blanket
  // `*.yml` mapping validates EAS workflows against the GitHub Actions schema.
  "files.associations": {
    "**/.eas/workflows/*.yml": "yaml"
  },

  // Regenerated by Metro / expo-router / expo — hand-edits are silently lost, and a
  // router.d.ts carried from another checkout encodes that branch's routes.
  "files.readonlyInclude": {
    "src/uniwind-types.d.ts": true,
    "expo-env.d.ts": true,
    ".expo/types/**": true
  },

  // /ios is prebuild output (~1.2 GB, ~9.8k files) and is never hand-edited.
  "search.exclude": {
    "ios": true,
    "build": true,
    ".claude/worktrees": true,
    "bun.lock": true,
    "src/db/migrations/meta": true
  },
  "files.watcherExclude": {
    "**/ios/**": true,
    "**/build/**": true,
    "**/.claude/worktrees/**": true
  },

  "explorer.fileNesting.patterns": {
    "package.json": "bun.lock, .bun-version, skills-lock.json, index.js",
    "app.json": "app.config.ts, eas.json, fingerprint.config.js, release-please-config.json, .release-please-manifest.json",
    "metro.config.js": "babel.config.js, drizzle.config.ts",
    "eslint.config.js": ".prettierrc",
    "tsconfig.json": "expo-env.d.ts",
    "README.md": "AGENTS.md, CLAUDE.md, CONTEXT.md, LICENSE"
  }
}
